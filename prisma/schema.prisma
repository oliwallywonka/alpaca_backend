// *****************************************************************************
//
// TOUR TRIPS MODULES START
//
// *****************************************************************************
enum TripState {
  programmed
  started
  confirmed
  cancelled

  @@map("trip_state")
}

model Trip {
  id              String            @id @default(uuid())
  tourID          String            @map("tour_id")
  registeredBy    String            @map("registered_by")
  customerID      String            @map("customer_id")
  state           TripState         @default(programmed)
  startDate       Int               @map("start_date")
  endDate         Int               @map("end_date")
  availableSlots  Int               @map("available_slots")
  numGuests       Int               @map("num_guests")
  pricePP         Decimal           @map("price_pp") //@db.Decimal(8, 2)
  total           Decimal //@db.Decimal(8, 2)
  createdAt       Int               @map("created_at")
  updatedAt       Int               @map("updated_at")
  tour            Tour              @relation(fields: [tourID], references: [id])
  user            User              @relation(fields: [registeredBy], references: [id])
  customer        Customer          @relation(fields: [customerID], references: [id])
  payments        Payment[]
  tripDestination TripDestination[]
  tripExpense     TripExpense[]
  TripResource    TripResource[]

  @@map("trip")
}

enum PaymentType {
  Cash
  CreditCard
  BankTransfer
  Paypal
  Stripe

  @@map("payment_type")
}

model Payment {
  id             String      @id @default(uuid()) @map("id")
  tripID         String      @map("trip_id")
  customerID     String      @map("customer_id")
  registeredByID String      @map("registered_by")
  movementID     String?     @map("movement_id")
  amount         Decimal     @map("amount") //@db.Decimal(8, 2)
  paymentMethod  PaymentType @map("payment_method")
  createdAt      Int         @map("created_at")
  updatedAt      Int         @map("updated_at")
  trip           Trip        @relation(fields: [tripID], references: [id])
  customer       Customer    @relation(fields: [customerID], references: [id])
  registeredBy   User        @relation(fields: [registeredByID], references: [id])
  movement       Movement?   @relation(fields: [movementID], references: [id])

  @@map("payment")
}

model TripExpense {
  id             String    @id @default(uuid())
  registeredByID String    @map("created_by_id")
  tripID         String    @map("trip_id")
  movementID     String?   @map("movement_id")
  amount         Decimal   @map("amount") //@db.Decimal(8, 2)
  description    String
  createdAt      Int       @map("created_at")
  updatedAt      Int       @map("updated_at")
  trip           Trip      @relation(fields: [tripID], references: [id])
  registeredBy   User      @relation(fields: [registeredByID], references: [id])
  movement       Movement? @relation(fields: [movementID], references: [id])

  @@map("trip_expense")
}

/**
 * model TripActivity {
 * id         String    @id @default(uuid())
 * tripID     String    @map("trip_id")
 * activityID String    @map("activity_id")
 * movementID String?   @map("movement_id")
 * pricePP    Decimal   @map("price_pp") //@db.Decimal(8, 2)
 * startDate  Int       @map("start_date")
 * endDate    Int       @map("end_date")
 * trip       Trip      @relation(fields: [tripID], references: [id])
 * activity   Activity  @relation(fields: [activityID], references: [id])
 * movement   Movement? @relation(fields: [movementID], references: [id])
 * @@map("trip_activity")
 * }
 */

/**
 * model TripMeal {
 * id         String    @id @default(uuid())
 * tripID     String    @map("trip_id")
 * mealID     String    @map("meal_id")
 * movementID String?   @map("movement_id")
 * pricePP    Decimal   @map("price_pp") //@db.Decimal(8, 2)
 * startDate  Int       @map("start_date")
 * endDate    Int       @map("end_date")
 * trip       Trip      @relation(fields: [tripID], references: [id])
 * meal       Meal      @relation(fields: [mealID], references: [id])
 * movement   Movement? @relation(fields: [movementID], references: [id])
 * @@map("trip_meal")
 * }
 */

model TripDestination {
  id            String      @id @default(uuid())
  tripID        String      @map("trip_id")
  destinationID String      @map("destination_id")
  pricePP       Decimal     @map("price_pp") //@db.Decimal(8, 2)
  startDate     Int         @map("start_date")
  endDate       Int         @map("end_date")
  trip          Trip        @relation(fields: [tripID], references: [id])
  destination   Destination @relation(fields: [destinationID], references: [id])

  @@map("trip_destination")
}

model TripResource {
  id         String    @id @default(uuid())
  tripID     String    @map("trip_id")
  resourceID String    @map("resource_id")
  movementID String?   @map("movement_id")
  total      Decimal   @map("total") //@db.Decimal(8, 2)
  startDate  Int       @map("start_date")
  endDate    Int       @map("end_date")
  trip       Trip      @relation(fields: [tripID], references: [id])
  resource   Resource  @relation(fields: [resourceID], references: [id])
  movement   Movement? @relation(fields: [movementID], references: [id])

  @@map("trip_resource")
}

/**
 * model TripHotel {
 * id         String    @id @default(uuid())
 * tripID     String    @map("trip_id")
 * hotelID    String    @map("hotel_id")
 * movementID String?   @map("movement_id")
 * pricePP    Decimal   @map("price_pp") //@db.Decimal(8, 2)
 * startDate  Int       @map("start_date")
 * endDate    Int       @map("end_date")
 * trip       Trip      @relation(fields: [tripID], references: [id])
 * hotel      Hotel     @relation(fields: [hotelID], references: [id])
 * movement   Movement? @relation(fields: [movementID], references: [id])
 * @@map("trip_hotel")
 * }
 */

// *****************************************************************************
//
// TOUR TRIPS MODULES END
//
// *****************************************************************************
