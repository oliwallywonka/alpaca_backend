// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator db {
  provider = "go run github.com/steebchen/prisma-client-go"
}

datasource db {
  // provider = "postgresql"
  //url      = env("DATABASE_URL")
  provider = "sqlite"
  url      = "file:../dev.db"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @default("")
  isActive    Boolean? @default(true) @map("is_active")
  permissions Json?    @default("[]") //@db.JsonB
  createdAt   Int      @map("created_at")
  updatedAt   Int      @map("updated_at")
  User        User[]

  @@map("role")
}

model Permission {
  id        String @id @default(uuid())
  name      String
  createdAt Int    @map("created_at")
  updatedAt Int    @map("updated_at")

  @@map("permission")
}

model User {
  id               String             @id @default(uuid())
  roleID           String             @map("role_id")
  email            String             @unique
  password         String
  name             String
  imageURL         String?            @map("image")
  contacts         Json?              @default("[]") //@db.JsonB
  createdAt        Int                @map("created_at")
  updatedAt        Int                @map("updated_at")
  isActive         Boolean            @default(true) @map("is_active")
  role             Role               @relation(fields: [roleID], references: [id])
  trips            Trip[]
  payments         Payment[]
  tripExpenses     TripExpense[]
  CashRegister     Ledger[]
  openSessions     LedgerSessions[]   @relation("LedgerSessionsOpens")
  closeSessions    LedgerSessions[]   @relation("LedgerSessionsCloses")
  Movement         Movement[]
  ServiceProviders ResourceProvider[]

  @@map("user")
}

model Customer {
  id          String    @id @default(uuid())
  title       String?
  firstName   String?   @map("first_name")
  middleName  String?   @map("middle_name")
  lastName    String?   @map("last_name")
  dateOfBirth String?   @map("date_of_birth")
  contacts    Json?     @default("[]") //@db.JsonB
  isLead      Boolean   @default(false) @map("is_lead")
  description String?   @default("")
  createdAt   Int       @map("created_at")
  updatedAt   Int       @map("updated_at")
  trip        Trip[]
  Payment     Payment[]

  @@map("customer")
}

model Provider {
  id               String             @id @default(uuid())
  name             String
  description      String?            @default("")
  contacts         Json?              @default("[]") //@db.JsonB
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        Int                @map("created_at")
  updatedAt        Int                @map("updated_at")
  ServiceProviders ResourceProvider[]

  @@map("provider")
}

/**
 * model Contact {
 * id    String @id @default(uuid())
 * type  String
 * value String
 * }
 */

// *****************************************************************************
//
// CASH FLOW MODULES START
//  
// *****************************************************************************

/**
 * model PriceRule {
 * id          String  @id @default(uuid())
 * min_persons Int     @map("min_persons")
 * max_persons Int     @map("max_persons")
 * price       Decimal //@db.Decimal(8, 2)
 * currency    String
 * isPerPerson Boolean @map("is_per_person")
 * createdAt   Int     @map("created_at")
 * updatedAt   Int     @map("updated_at")
 * @@map("price_rule")
 * }
 */

model Ledger {
  id             String           @id @default(uuid())
  ownerID        String           @map("owner_id")
  createdAt      Int              @map("created_at")
  updatedAt      Int              @map("updated_at")
  owner          User             @relation(fields: [ownerID], references: [id])
  LedgerSessions LedgerSessions[]

  @@map("cash_register")
}

model LedgerSessions {
  id            String     @id @default(uuid())
  ledgerID      String     @map("ledger_id")
  openedByID    String     @map("opened_by")
  closedByID    String?    @map("closed_by")
  openingAmount Json       @map("opening_amount") //@db.Decimal(8, 2)
  closingAmount Json       @map("closing_amount") //@db.Decimal(8, 2)
  status        String
  notes         String?
  createdAt     Int        @map("created_at")
  updatedAt     Int        @map("updated_at")
  ledger        Ledger     @relation(fields: [ledgerID], references: [id])
  openedBy      User       @relation(name: "LedgerSessionsOpens", fields: [openedByID], references: [id])
  closedBy      User?      @relation(name: "LedgerSessionsCloses", fields: [closedByID], references: [id])
  Movement      Movement[]

  @@map("ledger_sessions")
}

model Movement {
  id             String         @id @default(uuid())
  sessionID      String         @map("session_id")
  registeredByID String         @map("registered_by")
  amount         Decimal        @map("amount") //@db.Decimal(8, 2)
  type           String
  description    String?
  createdAt      Int            @map("created_at")
  updatedAt      Int            @map("updated_at")
  session        LedgerSessions @relation(fields: [sessionID], references: [id])
  registeredBy   User           @relation(fields: [registeredByID], references: [id])
  Payment        Payment[]
  TripExpense    TripExpense[]
  TripResource   TripResource[]

  @@map("movement")
}

// *****************************************************************************
//
// CASH FLOW MODULES END
//  
// *****************************************************************************

// *****************************************************************************
//
// SYSTEM CORE MODULES INIT
//
// *****************************************************************************
model Destination {
  id              String            @id @default(uuid())
  name            Json //@db.JsonB
  description     Json //@db.JsonB
  parentID        String?           @map("parent_id")
  location        Json? //@db.JsonB
  isDeleted       Boolean           @default(false) @map("is_deleted")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       Int               @map("created_at")
  updatedAt       Int               @map("updated_at")
  parent          Destination?      @relation("parent_child", fields: [parentID], references: [id])
  destinations    Destination[]     @relation("parent_child")
  tourDestination TourDestination[]
  tripDestination TripDestination[]

  @@map("destination")
}

model Tag {
  id          String    @id @default(uuid())
  title       Json //@db.JsonB
  description Json //@db.JsonB
  createdAt   Int       @map("created_at")
  updatedAt   Int       @map("updated_at")
  tourTag     TourTag[]

  @@map("tag")
}

// PROVIDER
/**
 * model Activity {
 * id             String         @id @default(uuid())
 * destinationID  String         @map("destination_id")
 * title          Json //@db.JsonB
 * description    Json //@db.JsonB
 * prices         Json           @default("[]") //@db.JsonB
 * contacts       Json           @default("[]") //@db.JsonB
 * images         Json           @default("[]") //@db.JsonB
 * isDeleted      Boolean        @default(false) @map("is_deleted")
 * createdAt      Int            @map("created_at")
 * updatedAt      Int            @map("updated_at")
 * destination    Destination    @relation(fields: [destinationID], references: [id])
 * tourActivities TourActivity[]
 * tripActivities TripActivity[]
 * @@map("activity")
 * }
 */

/**
 * enum MealType {
 * breackfast
 * lunch
 * dinner
 * extra
 * @@map("meal_type")
 * }
 */

/**
 * enum RoomType {
 * simple
 * double
 * shared
 * @@map("room_type")
 * }
 */

// PROVIDER
/**
 * model Hotel {
 * id        String      @id @default(uuid())
 * name      String
 * contacts  Json        @default("[]") //@db.JsonB
 * isDeleted Boolean     @default(false) @map("is_deleted")
 * createdAt Int         @map("created_at")
 * updatedAt Int         @map("updated_at")
 * hotelRoom HotelRoom[]
 * tourHotel TourHotel[]
 * tripHotel TripHotel[]
 * @@map("hotel")
 * }
 */

/**
 * model HotelRoom {
 * id        String   @id @default(uuid())
 * hotelID   String   @map("hotel_id")
 * type      RoomType @map("type")
 * prices    Json     @default("[]") //@db.JsonB
 * capacity  Int      @map("capacity")
 * hotel     Hotel    @relation(fields: [hotelID], references: [id])
 * createdAt Int      @map("created_at")
 * updatedAt Int      @map("updated_at")
 * @@map("hotel_room")
 * }
 */

enum ResourceEnum {
  Service
  Transport
  Activity
  Hotel
  Simple
  Double
  Shared
  Meal
  Breackfast
  Lunch
  Dinner
  Extra

  @@map("resource_enum")
}

model ResourceType {
  id                   String                 @id @default(uuid())
  type                 ResourceEnum
  ResourceResourceType ResourceResourceType[]

  @@map("resource_type")
}

model Resource {
  id                   String                 @id @default(uuid())
  destinationID        String?                @map("destination_id")
  location             Json? //@db.JsonB
  name                 Json //@db.JsonB
  description          Json //@db.JsonB
  images               Json                   @default("[]") //@db.JsonB
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            Int                    @map("created_at")
  updatedAt            Int                    @map("updated_at")
  ResourceResourceType ResourceResourceType[]
  ResourceProvider     ResourceProvider[]
  TripResource         TripResource[]

  @@map("resource")
}

model ResourceResourceType {
  id         String       @id @default(uuid())
  resourceID String       @map("resource_id")
  typeID     String       @map("type_id")
  createdAt  Int          @map("created_at")
  updatedAt  Int          @map("updated_at")
  resource   Resource     @relation(fields: [resourceID], references: [id])
  type       ResourceType @relation(fields: [typeID], references: [id])

  @@map("resource_resource_type")
}

model ResourceProvider {
  id                  String                @id @default(uuid())
  resourceID          String                @map("resource_id")
  providerID          String?               @map("provider_id")
  userID              String?               @map("user_id")
  refPrices           Json?                 @default("[]") @map("ref_prices")
  createdAt           Int                   @map("created_at")
  updatedAt           Int                   @map("updated_at")
  resource            Resource?             @relation(fields: [resourceID], references: [id])
  provider            Provider?             @relation(fields: [providerID], references: [id])
  user                User?                 @relation(fields: [userID], references: [id])
  TourServiceProvider TourServiceProvider[]

  @@map("resource_provider")
}

// *****************************************************************************
//
// SYSTEM CORE MODULES END
//
// *****************************************************************************

// *****************************************************************************
//
// TOUR CMS (CONTENT MANAGEMENT SYSTEM) MODULES INIT
//
// *****************************************************************************
model Tour {
  id                  String                @id @default(uuid())
  code                String                @unique
  name                Json //@db.JsonB
  slug                Json //@db.JsonB
  discountPercent     Decimal               @default(1) @map("discount_percent") //@db.Decimal(8, 2)
  days                Int                   @default(0)
  groupSize           String                @default("") @map("group_size")
  transport           Json //@db.JsonB
  accommodation       Json //@db.JsonB
  team                Json //@db.JsonB
  shortDescription    Json                  @map("short_description") //@db.JsonB
  longDescription     Json                  @map("long_description") //@db.JsonB
  images              Json                  @default("[]") //@db.JsonB
  isPublic            Boolean               @default(false) @map("is_public")
  isDeleted           Boolean               @default(false) @map("is_deleted")
  createdAt           Int                   @map("created_at")
  updatedAt           Int                   @map("updated_at")
  sectionDescription  SectionDescription[]
  tourTag             TourTag[]
  tourDestination     TourDestination[]
  trips               Trip[]
  TourServiceProvider TourServiceProvider[]

  @@map("tour")
}

model TourTag {
  id     String @id @default(uuid())
  tourID String @map("tour_id")
  tagID  String @map("tag_id")
  tour   Tour   @relation(fields: [tourID], references: [id])
  tag    Tag    @relation(fields: [tagID], references: [id])

  @@map("tour_tag")
}

model TourVariant {
  id                  String                @id @default(uuid())
  tourID              String                @map("tour_id")
  minPersons          Int                   @map("min_persons")
  maxPersons          Int                   @map("max_persons")
  totalPrice          Decimal               @default(0) //@db.Decimal(8, 2)
  createdAt           Int                   @map("created_at")
  updatedAt           Int                   @map("updated_at")
  SectionDescription  SectionDescription[]
  TourDestination     TourDestination[]
  TourServiceProvider TourServiceProvider[]

  @@map("tour_variant")
}

model SectionDescription {
  id            String      @id @default(uuid())
  tourVariantID String      @map("tour_variant_id")
  tourID        String      @map("tour_id")
  images        Json        @default("[]") //@db.JsonB
  description   Json //@db.JsonB
  startDate     Int         @default(0)
  endDate       Int         @default(0)
  createdAt     Int         @map("created_at")
  updatedAt     Int         @map("updated_at")
  tour          Tour        @relation(fields: [tourID], references: [id])
  tourVariant   TourVariant @relation(fields: [tourVariantID], references: [id])

  @@map("section_description")
}

model TourDestination {
  id            String      @id @default(uuid())
  destinationID String      @map("destination_id")
  tourID        String      @map("tour_id")
  tourVariantID String      @map("tour_variant_id")
  description   Json //@db.JsonB
  startDate     Int         @default(0)
  endDate       Int         @default(0)
  createdAt     Int         @map("created_at")
  updatedAt     Int         @map("updated_at")
  destination   Destination @relation(fields: [destinationID], references: [id])
  tour          Tour        @relation(fields: [tourID], references: [id])
  tourVariant   TourVariant @relation(fields: [tourVariantID], references: [id])

  @@map("tour_destination")
}

/**
 * model TourActivity {
 * id         String   @id @default(uuid())
 * tourID     String   @map("tour_id")
 * activityID String   @map("activity_id")
 * startDate  Int      @default(0)
 * endDate    Int      @default(0)
 * createdAt  Int      @map("created_at")
 * updatedAt  Int      @map("updated_at")
 * tour       Tour     @relation(fields: [tourID], references: [id])
 * activity   Activity @relation(fields: [activityID], references: [id])
 * @@map("tour_activity")
 * }
 */

/**
 * model TourMeals {
 * id        String @id @default(uuid())
 * tourID    String @map("tour_id")
 * mealID    String @map("meal_id")
 * startDate Int    @default(0)
 * endDate   Int    @default(0)
 * createdAt Int    @map("created_at")
 * updatedAt Int    @map("updated_at")
 * tour      Tour   @relation(fields: [tourID], references: [id])
 * meal      Meal   @relation(fields: [mealID], references: [id])
 * @@map("tour_meals")
 * }
 */

/**
 * model TourHotel {
 * id        String @id @default(uuid())
 * tourID    String @map("tour_id")
 * hotelID   String @map("hotel_id")
 * startDate Int    @default(0)
 * endDate   Int    @default(0)
 * createdAt Int    @map("created_at")
 * updatedAt Int    @map("updated_at")
 * tour      Tour   @relation(fields: [tourID], references: [id])
 * hotel     Hotel  @relation(fields: [hotelID], references: [id])
 * @@map("tour_hotel")
 * }
 */

model TourServiceProvider {
  id                 String           @id @default(uuid())
  tourID             String           @map("tour_id")
  tourVariantID      String           @map("tour_variant_id")
  resourceProviderID String           @map("resource_provider_id")
  startDate          Int              @default(0)
  endDate            Int              @default(0)
  originalCost       Decimal?         @map("original_cost") //@db.Decimal(8, 2)
  currency           String?          @map("currency")
  profitPercent      Decimal?         @map("profit_percent") //@db.Decimal(8, 2) 
  dollarChangeRage   Decimal?         @map("dollar_change_rage") //@db.Decimal(8, 2)
  quantity           Int              @default(1)
  isVisible          Boolean          @default(false) @map("is_visible")
  createdAt          Int              @map("created_at")
  updatedAt          Int              @map("updated_at")
  tour               Tour             @relation(fields: [tourID], references: [id])
  resourceProvider   ResourceProvider @relation(fields: [resourceProviderID], references: [id])
  tourVariant        TourVariant      @relation(fields: [tourVariantID], references: [id])

  @@map("tour_resource_provider")
}

